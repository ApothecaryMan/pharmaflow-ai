{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "pharmaflow-theme": {
      "type": "local",
      "command": ["npx", "tsx", "mcp-design-server/index.ts"],
      "enabled": true,
      "env": {
        "MCP_WS_PORT": "3456"
      }
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=vhewcoumaxicnfsjwcai",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:SUPABASE_ACCESS_TOKEN}"
      },
      "enabled": true
    }
  }
}
